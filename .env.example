# =============================================================================
# Mobile ATQC Bootcamp - Environment Configuration Example
# Copy this file to `.env` and fill in your local or cloud values.
# =============================================================================

# -----------------------------------------------------------------------------
# Local Appium Server & Execution Environment
# -----------------------------------------------------------------------------
# Target environment profile: local_android | local_ios | browserstack
TEST_ENV=local_android

# Appium 3.x Server URL
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Path to mobile application binary (.apk or .ipa)
APP_PATH=apps/sauce_demo_app.apk

# -----------------------------------------------------------------------------
# Android SDK & Device Configuration
# -----------------------------------------------------------------------------
ANDROID_HOME=D:\AndroidSDK
ANDROID_SERIAL=emulator-5554
DEVICE_NAME=Pixel_7_API_34

# Target Android Application Package & Activity
APP_PACKAGE=com.saucelabs.mydemoapp.android
APP_ACTIVITY=com.saucelabs.mydemoapp.android.view.activities.SplashActivity

# -----------------------------------------------------------------------------
# BrowserStack Cloud Configuration (Required when --env=browserstack)
# -----------------------------------------------------------------------------
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key
BROWSERSTACK_APP_ID=bs://your_uploaded_app_id

# -----------------------------------------------------------------------------
# Demo Application Credentials
# -----------------------------------------------------------------------------
SAUCE_STANDARD_USER=bod@example.com
SAUCE_LOCKED_USER=alice@example.com
SAUCE_VISUAL_USER=visual@example.com
SAUCE_DEFAULT_PASSWORD=10203040
